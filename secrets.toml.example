# ตัวอย่างเท่านั้น — ค่าจริงใส่ใน Streamlit Cloud: Manage app → Settings → Secrets (ห้ามใส่ใน GitHub)
sheet_url = "https://docs.google.com/spreadsheets/d/<ID ของชีต>/edit"

# ผู้ช่วย AI (Google Gemini) — สร้าง key ที่ aistudio.google.com
GEMINI_API_KEY = "ใส่ key"
# GEMINI_MODEL = "gemini-3.7-flash"

# (แนะนำ) อ่านชีตแบบส่วนตัวด้วย Service account — ปิดการแชร์ลิงก์ของชีตได้
# วางค่าจากไฟล์ JSON ที่ดาวน์โหลดจาก Google Cloud
# [gcp_service_account]
# type = "service_account"
# project_id = "..."
# private_key_id = "..."
# private_key = "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# client_email = "demand-dashboard@<project>.iam.gserviceaccount.com"
# client_id = "..."
# token_uri = "https://oauth2.googleapis.com/token"
